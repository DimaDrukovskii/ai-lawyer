# Провайдер LLM: yandex | gigachat | mock (mock — прогон без ключей, для проверки структуры)
LLM_PROVIDER=yandex

# --- Yandex AI Studio (OpenAI-совместимый API) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Идентификаторы моделей БЕЗ префикса gpt://<folder>/ — префикс добавляется автоматически.
# Актуальный список моделей смотри в консоли AI Studio.
MODEL_STRONG=aliceai-llm
MODEL_FAST=aliceai-llm

# --- Yandex Search API (веб-поиск для исследователей) ---
# Если пусто — используется YANDEX_API_KEY (у ключа должна быть роль на Search API)
YANDEX_SEARCH_API_KEY=

# --- GigaChat (экспериментальный адаптер, не проверен на живом API) ---
GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_CA_BUNDLE=/path/to/russian_trusted_root_ca.pem

# --- Ограничители ---
MAX_PARALLEL=6
MAX_TOOL_STEPS=8
MAX_CLAIMS_PER_ZONE=12
# Лимит токенов ответа агентов. Обрезанный по лимиту ответ — ошибка, а не «пустой результат»
MAX_OUTPUT_TOKENS=6000
# Разрешить fetch_url на доменах вне белого списка (по умолчанию нет)
ALLOW_UNKNOWN_DOMAINS=0
